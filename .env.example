# Copie para .env e defina valores próprios. O arquivo .env nunca deve ser versionado.
DB_NAME=blockready
DB_USER=blockready
DB_PASSWORD=defina-uma-senha-forte
DB_PORT=5432
APP_PORT=8080
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=INFO

# Primeiro administrador (opcional). Defina ambos para criar o admin inicial na primeira execução.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Use true quando a aplicação for servida por HTTPS.
SESSION_COOKIE_SECURE=false
